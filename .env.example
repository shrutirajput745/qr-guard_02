# QR Guard 2.0 — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Optional: VirusTotal API (Threat Intelligence) ───────────────────────
# Sign up free at https://www.virustotal.com/gui/join-us
# When set, /api/analyze will check URLs against the VirusTotal database.
# The app works fully without this key (heuristic analysis only).
VIRUSTOTAL_API_KEY=

# ─── Optional: URLScan.io API (Threat Intelligence) ───────────────────────
# Sign up free at https://urlscan.io/user/signup
URLSCAN_API_KEY=

# ─── Server Configuration ─────────────────────────────────────────────────
PORT=3000

# ─── Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
